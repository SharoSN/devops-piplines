{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "ruby \"$CLAUDE_PROJECT_DIR/.claude/hooks/validate-yaml.rb\"",
            "timeout": 30,
            "statusMessage": "Validating YAML..."
          }
        ]
      }
    ]
  }
}
